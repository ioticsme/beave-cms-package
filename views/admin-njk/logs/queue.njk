{% extends "admin-njk/layouts/master.njk" %}

{%block csslib %}
	<link href="/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css" />
{%endblock%}

{% block content %}
	<div class="d-flex flex-column flex-column-fluid">
        <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
            <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                    Queue Listing
                    </h1>
                    <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a class="text-muted text-hover-primary" href="{{LANDING_URL}}">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">Logs</li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">Queue Listing</li>
                    </ul>
                </div>
            </div>
        </div>
        <div id="kt_app_content" class="app-content flex-column-fluid">
            <div id="kt_app_content_container" class="app-container container-xxl">
            <div class="card card-flush">
                <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute ms-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="currentColor"/>
                        <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="currentColor"/>
                        </svg>
                    </span>
                    <input class="form-control form-control-solid w-250px ps-14" type="text" data-beaver-ecommerce-category-filter="search" placeholder="Search queue">
                    </div>
                </div>
                <div class="card-toolbar flex-row-fluid justify-content-end gap-5">
                    
                </div>
                </div>
                <div class="card-body pt-0">
                <table id="beaver_ecommerce_category_table" class="table align-middle table-row-dashed fs-6 gy-5">
                    <thead>
                    <tr class="text-start text-gray-800 fw-bold fs-7 text-uppercase gs-0">
                        <th class="min-w-250px">Name</th>
                        <th class="text-center">Payload</th>
                        <th class="text-center">Type</th>
                        <th class="text-center">Next Run At</th>
                        <th class="text-center">Fail count</th>
                        <th class="text-center">Fail reason</th>
                        <th class="text-center">Failed at</th>
                        <th class="text-center">Last finished date</th>
                    </tr>
                    </thead>
                    <tbody class="fw-semibold">
                        {% for item in data %}
                            <tr>
                            <td data-kt-ecommerce-order-filter="order_id">
                                <small>
                                <a class="text-gray-800 text-hover-primary fw-bold" >{{ item.name }}</a>
                                </small>
                            </td>
                            <td class="text-start pe-0">
                                {% for key, value in item.data.payload %}
                                    <small>{{ key }}: {{ value }}</small><br>
                                {% endfor %}
                            </td>
                            <td class="text-start pe-0">{{ item.type }}</td>
                            <td class="text-start pe-0">
                                <small>{{ convertDate(item.nextRunAt,'dd-MM-yyyy HH:mm:ss') }}</small>
                            </td>
                            <td class="text-center pe-0">{{ item.failCount }}</td>
                            <td class="text-start pe-0">
                                <small>{{ item.failReason }}</small>
                            </td>
                            <td class="text-end pe-0">
                                <small>{{ convertDate(item.failedAt,'dd-MM-yyyy HH:mm:ss') }}</small>
                            </td>
                            <td class="text-end pe-0">
                                <small>{{ convertDate(item.lastFinishedAt,'dd-MM-yyyy HH:mm:ss') }}</small>
                            </td>
                            </tr>
                            {% endfor %}
                    </tbody>
                </table>
                </div>
            </div>
            </div>
        </div>
        </div>
{% endblock %}

{% block jslib %}
    <script src="/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="/static/custom/category-table.js"></script>
    <script src="/cms-static/common/js/custom-functions.js"></script>
{% endblock %}

{% block customScript %}
    <script>
    </script>
{% endblock %}


