{% block customScript %}
	<script>
		function changeStatus(status, mode) {
			fetch("/admin/settings/general/brand/change-status", {
				method: 'POST',
				cache: 'no-cache',
				headers: {
					Accept: 'application/json',
					'Content-Type': 'application/json'
				},
				body: JSON.stringify({status, mode})
			})
				.then(async (res) => {
					const status = res.status
					let data = await res.json()
					if (status >= 200 && status < 300) {
						location.reload()
					} else {
						Swal.fire({
							text: data.error || 'Something went wrong.',
							icon: 'warning',
							buttonsStyling: !1,
							confirmButtonText: 'Ok, got it!',
							customClass: {
								confirmButton: 'btn fw-bold btn-primary'
							}
						})
					}
				})
				.catch((err) => {
					Swal.fire({
						text: 'Something went wrong !.',
						icon: 'error',
						buttonsStyling: !1,
						confirmButtonText: 'Ok, got it!',
						customClass: {
							confirmButton: 'btn fw-bold btn-primary'
						}
					})
				})
			}
		function clearCache() {
			Swal
				.fire({
					text: 'Are you sure you want to clear cache ?',
					icon: 'warning',
					showCancelButton: !0,
					buttonsStyling: !1,
					confirmButtonText: 'Yes, Clear!',
					cancelButtonText: 'No, cancel',
					customClass: {
						confirmButton: 'btn fw-bold btn-danger',
						cancelButton: 'btn fw-bold btn-active-light-primary'
					}
				})
				.then((e) => {
					if (e.value) {
						fetch("/admin/settings/general/clear-cache", {
							method: 'POST',
							cache: 'no-cache',
							headers: {
								Accept: 'application/json',
								'Content-Type': 'application/json'
							},
							body: JSON.stringify({})
						})
							.then(async (res) => {
								const status = res.status
								let data = await res.json()
								if (status >= 200 && status < 300) {
									location.reload()
								} else {
									Swal.fire({
										text: data.error || 'Something went wrong.',
										icon: 'warning',
										buttonsStyling: !1,
										confirmButtonText: 'Ok, got it!',
										customClass: {
											confirmButton: 'btn fw-bold btn-primary'
										}
									})
								}
							})
							.catch((err) => {
								Swal.fire({
									text: 'Something went wrong !.',
									icon: 'error',
									buttonsStyling: !1,
									confirmButtonText: 'Ok, got it!',
									customClass: {
										confirmButton: 'btn fw-bold btn-primary'
									}
								})
							})
						}
				})
		}
	</script>

{% endblock %}

{% block content %}
	<div class="d-flex flex-column flex-column-fluid">
		<div class="app-toolbar py-3 py-lg-6" id="beave_app_toolbar">
			<div class="app-container container-xxl d-flex flex-stack" id="beave_app_toolbar_container">
				<div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
					<h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">General Settings</h1>
					<ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
						<li class="breadcrumb-item text-muted">
							<a class="text-muted text-hover-primary" href="{{LANDING_URL}}">Home</a>
						</li>
						<li class="breadcrumb-item">
							<span class="bullet bg-gray-400 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">Settings</li>
						<li class="breadcrumb-item">
							<span class="bullet bg-gray-400 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">General</li>
					</ul>
				</div>
			</div>
		</div>
		<div class="app-content flex-column-fluid" id="beave_app_content">
			<div class="app-container container" id="beave_app_content_container">
				<div class="row g-5 g-xl-10 mb-xl-10">
					<div class="col-lg-4 col-md-6">
						<div class="card mb-5 pb-4">
							<div class="card-header">
								<h3 class="card-title">App Maintenance Mode</h3>
							</div>
							<div class="card-body">
								<div class="form-check form-switch form-check-custom form-check-solid">
									<input id="status-toggle-a" class="form-check-input cursor-pointer" type="checkbox" {{ 'checked' if domain.maintenance_mode }} onchange="changeStatus({{ domain.maintenance_mode }}, 1)" value="{{ domain.maintenance_mode }}">
									<label class="form-check-label cursor-pointer" for="status-toggle-a">
										{% if domain.maintenance_mode %}
											<div class="badge badge-light-danger">Site in Maintenance Mode</div>
										{% else %}
											<div class="badge badge-light-success">Site Active</div>
										{% endif %}
									</label>
								</div>
							</div>
						</div>
					</div>
					{% if hasEcommerce %}
					<div class="col-lg-4 col-md-6">
						<div class="card mb-5 pb-4">
							<div class="card-header">
								<h3 class="card-title">Ecommerce Maintenance Mode</h3>
							</div>
							<div class="card-body">
								<div class="form-check form-switch form-check-custom form-check-solid">
									<input id="status-toggle-a" class="form-check-input cursor-pointer" type="checkbox" {{ 'checked' if domain.ecommerce_maintenance_mode }} onchange="changeStatus({{ domain.ecommerce_maintenance_mode }}, 2)" value="{{ domain.ecommerce_maintenance_mode }}">
									<label class="form-check-label cursor-pointer" for="status-toggle-a">
										{% if domain.ecommerce_maintenance_mode %}
											<div class="badge badge-light-danger">Ecommerce in Maintenance Mode</div>
										{% else %}
											<div class="badge badge-light-success">Ecommerce Active</div>
										{% endif %}
									</label>
								</div>
							</div>
						</div>
					</div>
					{% endif %}
					<div class="col-lg-3">
						<div class="card mb-5">
							<div class="card-header">
								<h3 class="card-title">Clear all cache (REDIS)</h3>
							</div>
							<div class="card-body text-center">
								<button class="btn btn-danger" onclick="clearCache()">
									<i class="las la-trash fs-2x"></i>
									Flush Cache
								</button>
							</div>
						</div>
					</div>
				</div>

				<div class="row g-5 g-xl-10 mb-xl-10">
					<div class="col-lg-12">
						<div class="card mb-5">
							<div class="card-header">
								<h3 class="card-title">Brand Logo</h3>
							</div>
							<div class="card-body">
								<style>
									.image-input-placeholder {
										background-image: url("/cms-static/admin/assets/media/svg/files/blank-image.svg");
									}
									[data-theme="dark"] .image-input-placeholder {
										background-image: url("/cms-static/admin/assets/media/svg/files/blank-image-dark.svg");
									}
								</style>
								<div class="image-input image-input-empty image-input-outline image-input-placeholder" data-kt-image-input="true">
									{% if brand and brand.logo and brand.logo.en and brand.logo.en.media_url %}
										<img src="{{ brand.logo.en.media_url }}" style="max-width: 200px;">
									{% else %}
										<img src="/cms-static/admin/assets/media/svg/files/blank-image.svg" style="max-width: 200px;">
									{% endif %}
									
								</div>
								<a href="/admin/settings/general/brand/change-logo/{{ brand._id }}?brand=true"
									class="btn btn-primary ms-5"
									data-kt-image-input-action="change"
									data-bs-toggle="tooltip"
									data-bs-dismiss="click"
									title="Change Logo">
									<i class="fa fa-pen fs-7"></i>
								</a>
								<h4>Domains</h4>
								<table class="table align-middle table-row-dashed fs-6 gy-5">
									<thead>
										<tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
											<th class="min-w-200px">Logo</th>
											<th class="min-w-200px">Country</th>
											<th class="text-end min-w-70px">Actions</th>
										</tr>
									</thead>
									{% for item in domains %}
										<tr>
											<td>
												<div class="d-flex align-items-center">
													<a class="" href="/admin/settings/general/brand/change-logo/{{ item.country._id }}?domain=true">
														{% if item.logo and item.logo.en and item.logo.en.media_url %}
															<img src="{{ item.logo.en.media_url }}" style="max-width: 200px;">
														{% else %}
															Add logo
														{% endif %}
													</a>
												</div>
											</td>
											<td>
												<a class="text-gray-800 text-hover-primary fs-5 fw-bold" href="/admin/settings/general/brand/change-logo/{{ item.country._id }}?domain=true">{{ item.country.name.en }}</a>
											</td>

											<td class="text-end">
												<a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-beaver-menu-trigger="click" data-beaver-menu-placement="bottom-end">Actions
													<span class="svg-icon svg-icon-5 m-0">
														<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
															<path d="M11.4343 12.7344L7.25 8.55005C6.83579 8.13583 6.16421 8.13584 5.75 8.55005C5.33579 8.96426 5.33579 9.63583 5.75 10.05L11.2929 15.5929C11.6834 15.9835 12.3166 15.9835 12.7071 15.5929L18.25 10.05C18.6642 9.63584 18.6642 8.96426 18.25 8.55005C17.8358 8.13584 17.1642 8.13584 16.75 8.55005L12.5657 12.7344C12.2533 13.0468 11.7467 13.0468 11.4343 12.7344Z" fill="currentColor"/>
														</svg>
													</span>
												</a>
												<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-125px py-4" data-beaver-menu="true">
													<div class="menu-item px-3">
														<a href="/admin/settings/general/brand/change-logo/{{ item.country._id }}?domain=true" class="menu-link px-3">Edit</a>
													</div>
												</div>
											</td>
										</tr>
									{% endfor %}
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}