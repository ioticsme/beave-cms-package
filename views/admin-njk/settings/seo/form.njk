{% extends "../../layouts/master.njk" %}

{% block csslib %}
	<link href='/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.css' rel='stylesheet' type='text/css'/>
	<link href='/cms-static/admin/assets/plugins/global/plugins.bundle.css' rel='stylesheet' type='text/css'/>
	<link href='/cms-static/admin/assets/css/style.bundle.css' rel='stylesheet' type='text/css'/>
{% endblock %}

{% block jslib %}
	{# // begin::Vendors Javascript(used by this page) #}
	<script src='/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.js'></script>
	<script src='/cms-static/admin/assets/plugins/custom/formrepeater/formrepeater.bundle.js'></script>
	<script src='/cms-static/common/js/form-data-json.min.js'></script>
	<script src='/cms-static/common/js/es-form.js'></script>
{% endblock %}

{% block content %}
	<div class="d-flex flex-column flex-column-fluid">
		<div class="app-toolbar py-3 py-lg-6" id="beaver_app_toolbar">
			<div class="app-container container-xxl d-flex flex-stack" id="beaver_app_toolbar_container">
				<div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
					<h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">SEO Settings</h1>
					<ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
						<li class="breadcrumb-item text-muted">
							<a class="text-muted text-hover-primary" href="{{LANDING_URL}}">Home</a>
						</li>
						<li class="breadcrumb-item">
							<span class="bullet bg-gray-400 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">Settings</li>
						<li class="breadcrumb-item">
							<span class="bullet bg-gray-400 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">SEO</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="app-content flex-column-fluid" id="beaver_app_content">
			<div class="app-container container-xxl" id="beaver_app_content_container">
				<form class="form es-form d-flex flex-column flex-lg-row" id="beaver_subscriptions_create_new" action="/admin/settings/seo/save" data-redirect-url="/admin/settings/seo" method="post">
					<div class="d-flex flex-column flex-row-fluid gap-7 gap-lg-10">
						<div class="card card-flush py-4">
							<div class="card-header">
								<div class="card-title">
									<h2 class="fw-bold">SEO</h2>
								</div>
								<div class="card-toolbar">
									<button class="btn btn-sm btn-success form-submit-btn" id="save-btn" type="submit">
										<span class="label">Save</span>
										<span class="preloader d-none">Saving...</span></button>
								</div>
							</div>
							<div class="card-body pt-0 mb-10">
								<ul class="nav nav-tabs nav-line-tabs mb-5 fs-6">
									{% for brandLanguage in authUser.brand.languages %}
										<li class="nav-item">
											<a class="nav-link {{ 'active' if loop.index == 1 }}" data-bs-toggle="tab" href="#beaver_tab_pane_{{ brandLanguage.prefix }}">
												{{ brandLanguage.name }}
												<span class="fa-solid fa-circle-exclamation d-none tab-invalid-icon"></span>
											</a>
										</li>
									{% endfor %}
								</ul>

								<div class="tab-content tab-content-fields" id="myTabContent">
									{% for brandLanguage in authUser.brand.languages %}
										<div class="tab-pane fade {{ 'active show' if loop.index == 1 }}" role="tabpanel" id="beaver_tab_pane_{{ brandLanguage.prefix }}">
											<div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container col-md-6">
												<label class="d-flex align-items-center fs-6 fw-semibold mb-2">
													<span class="required"> Meta Title ({{ brandLanguage.prefix }})</span>
												</label>
												<input type="text" name="title[{{ brandLanguage.prefix }}]" value="{{ data.meta.title[brandLanguage.prefix] }}" class="form-control">
												<div class="fv-plugins-message-container invalid-feedback" id="field-error-title_{{ brandLanguage.prefix }}"></div>
											</div>
											<div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container col-md-6">
												<label class="d-flex align-items-center fs-6 fw-semibold mb-2">
													<span class="required"> Meta Description ({{ brandLanguage.prefix }})</span>
												</label>
												<textarea type="text" name="description[{{ brandLanguage.prefix }}]" class="form-control">{{ data.meta.description[brandLanguage.prefix] }}</textarea>
												<div class="fv-plugins-message-container invalid-feedback" id="field-error-description_{{ brandLanguage.prefix }}"></div>
											</div>

											<div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container col-md-6">
												<label class="d-flex align-items-center fs-6 fw-semibold mb-2">
													<span class="required"> Meta Keywords ({{ brandLanguage.prefix }})</span>
												</label>
												<textarea type="text" placeholder="Enter Meta Keywords (comma(,) seperated)" name="keywords[{{ brandLanguage.prefix }}]" class="form-control">{{ data.meta.keywords[brandLanguage.prefix] }}</textarea>
												<div class="fv-plugins-message-container invalid-feedback" id="field-error-keywords_{{ brandLanguage.prefix }}"></div>
											</div>
											<div class="mt-2">
												<label class="d-flex align-items-center fs-6 fw-semibold mb-5">
													<span class="required">Image ({{ brandLanguage.prefix }})</span>
												</label>
												<span class='media-uploader-field'>
													<span class="media_preview">
														<span class="preview-holder">
															{% if data.meta.og_image[brandLanguage.prefix].media_url %}
																<img src="{{data.meta.og_image[brandLanguage.prefix].media_url}}" style="max-width: 200px;"/>
															{% endif %}
														</span>
														<a class="btn btn-danger btn-icon image-preview-remove-btn my-1 {{'d-none'  if not data.meta.og_image[brandLanguage.prefix].media_url}}">
															<i class="fa fa-trash" tabindex="-1"></i>
														</a>
													</span>
													<input type="hidden" class="media_url_field" name="image[{{ brandLanguage.prefix }}[media_url]]" value="{{data.meta.og_image[brandLanguage.prefix].media_url}}">
													<input type="hidden" class="media_title_field" name="image[{{ brandLanguage.prefix }}[title]]" value="{{data.meta.og_image[brandLanguage.prefix].title}}">
													<input type="hidden" class="media_alt_text_field" name="image[{{ brandLanguage.prefix }}[alt_text]]" value="{{data.meta.og_image[brandLanguage.prefix].alt_text}}">
													<input type="hidden" class="media_link_url_field" name="image[{{ brandLanguage.prefix }}[link_url]]" value="">
													<input type="hidden" class="media_open_link_in_new_tab_field" name="image[{{ brandLanguage.prefix }}[open_link_in_new_tab]]" value="">
													<input type="hidden" class="media_local_drive_field" name="image[{{ brandLanguage.prefix }}[drive]]" value="imagekit">
													<a class="btn btn-success media-uploader-modal-btn" id="beaver-media-field-{{loop.index}}-{{range(100,10000)|random}}" data-bs-toggle='modal' data-bs-target='#beaver_modal_media_list'>Attach Media</a>
												</span>
											</div>
											<div class="fv-plugins-message-container invalid-feedback" id="field-error-image_{{ brandLanguage.prefix }}_media_url"></div>
										</div>
									{% endfor %}
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}