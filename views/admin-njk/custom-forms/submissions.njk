{% extends "../layouts/master.njk" %}

{% block csslib %}
	<link href='/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.css' rel='stylesheet' type='text/css'/>

{% endblock %}

{% block jslib %}
	<script src='/cms-static/admin/assets/plugins/custom/datatables/datatables.bundle.js'></script>

	{# <script src='/cms-static/admin/assets/js/custom/apps/subscriptions/list/export.js'></script> #}

	{# //- custom functions  #}
	<script src='/cms-static/common/js/custom-data-table.js'></script>
	<script src='/cms-static/common/js/custom-functions.js'></script>
{% endblock %}

{% block customScript %}
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var table = new DataTable('#beav_subscriptions_table', {
				responsive: true,
				paging: true,
				searching: true,
				info: true,
				dom: 'Bfrtip', // Add this line to include the buttons
				buttons: [
					{
						extend: 'csv',
						filename: function () {
							return 'Form Submission List - ' + '{{reqForm.type}}'; // e.g., 'Report_2024-08-06'
						},
						exportOptions: {
							columns: ':not(:eq(-1))'
						}
					}, {
						extend: 'excel',
						filename: function () {
							return 'Form Submission List - ' + '{{reqForm.type}}'; // e.g., 'Report_2024-08-06'
						},
						exportOptions: {
							columns: ':not(:eq(-1))'
						}
					}
				]
			});
		});
	</script>
{% endblock %}

{% block content %}
	{% block title %}
		<title>Custom Form Submissions | {{browserTitle | upper()}} CMS</title>
	{% endblock %}
	
	<div class="d-flex flex-column flex-column-fluid">
		<div class="app-toolbar py-3 py-lg-6" id="beaver_app_toolbar">
			<div class="app-container container-xxl d-flex flex-stack" id="beaver_app_toolbar_container">
				<div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
					<h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Custom Form Submissions | {{reqForm.form_name.en}}</h1>
					<ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
						<li class="breadcrumb-item text-muted">
							<a class="text-muted text-hover-primary" href="{{LANDING_URL}}">Home</a>
						</li>
						<li class="breadcrumb-item">
							<span class="bullet bg-gray-400 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">
							<a class="text-muted text-hover-primary" href="/admin/custom-forms">Custom Forms</a>
						</li>
						<li class="breadcrumb-item">
							<span class="bullet bg-gray-400 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">Submissions</li>
					</ul>
				</div>
				<div class="d-flex align-items-center gap-2 gap-lg-3">
					{# <a class="btn btn-sm fw-bold btn-primary" href="/admin/custom-forms/add">Create New Form</a> #}
					<a class="btn btn-sm fw-bold btn-primary" href="/admin/custom-forms/submissions/{{reqForm._id}}/export">Export </a>
				</div>
			</div>
		</div>
		<div class="app-content flex-column-fluid" id="beaver_app_content">
			<div class="app-container container-xxl" id="beaver_app_content_container">
				<div class="card">
					<div class="card-header border-0 pt-6">
						<div class="card-title">
							<div class="d-flex align-items-center position-relative my-1">
								<span class="svg-icon svg-icon-1 position-absolute ms-6">
									<svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
										<rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="currentColor"></rect>
										<path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="currentColor"></path>
									</svg>
								</span>
								<input class="form-control form-control-solid w-250px ps-14" type="text" data-beaver-custom-data-table-filter="search" placeholder="Search Submission"/>
							</div>
						</div>
					</div>
					<div class="card-body pt-0">
						<table class="table align-middle table-row-dashed fs-6 gy-5" id="beaver_custom_data_table">
							<thead>
								<tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
									{% for field in column_to_list %}
										{# TODO: replace .en with default language #}
										<th class="min-w-125px w-400px">{{field.field_label.en}}</th>
									{% endfor %}
									{# <th class="min-w-125px">Type</th> #}
									<th class="min-w-125px">Created Date</th>
									<th class="text-end min-w-70px">Actions</th>
								</tr>
							</thead>
							<tbody class="text-gray-600 fw-semibold">
								{# //- BEGIN::Data Loop #}
								{% for item in data %}
									<tr>
										{%for column in column_to_list%}
											<td>
												{{item.field_values[column.field_name]}}
											</td>
										{%endfor%}
										<td>{{ item.date_created }}</td>
										<td class="text-end">
											<a class="btn btn-light btn-active-light-primary btn-sm" href="#" data-beaver-menu-trigger="click" data-beaver-menu-placement="bottom-end">Actions<span class="svg-icon svg-icon-5 m-0">
													<svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
														<path d="M11.4343 12.7344L7.25 8.55005C6.83579 8.13583 6.16421 8.13584 5.75 8.55005C5.33579 8.96426 5.33579 9.63583 5.75 10.05L11.2929 15.5929C11.6834 15.9835 12.3166 15.9835 12.7071 15.5929L18.25 10.05C18.6642 9.63584 18.6642 8.96426 18.25 8.55005C17.8358 8.13584 17.1642 8.13584 16.75 8.55005L12.5657 12.7344C12.2533 13.0468 11.7467 13.0468 11.4343 12.7344Z" fill="currentColor"></path>
													</svg>
												</span>
											</a>
											<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-225px py-4" data-beaver-menu="true">
												<div class="menu-item px-3">
													<a href="/admin/custom-forms/submissions/{{reqForm._id}}/{{item._id}}" class="menu-link px-3">View</a>
												</div>
												<div class="menu-item px-3">
													<a id="{{item._id}}" url="/admin/custom-forms/submissions/delete" data-beaver-subscriptions-table-filter="delete_row" onClick="deleteItem(this)" class="menu-link px-3">Delete</a>
												</div>
											</div>

										</td>
									</tr>
								{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>

	{% endblock %}